# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email (MailerSend)
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_ANNUAL_PRICE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Security
CRON_SECRET=

# Application URLs (used in email links and OAuth redirects)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SITE_URL=

# Google Places (location autocomplete on event forms)
GOOGLE_PLACES_API_KEY=

# Eventbrite OAuth integration (optional)
EVENTBRITE_CLIENT_ID=
EVENTBRITE_CLIENT_SECRET=

# Discord OAuth integration (optional) — guild-connect flow only.
# Sign-in-with-Discord's client secret is configured in the Supabase
# Dashboard (Authentication > Providers), not here.
DISCORD_CLIENT_ID=

# Discord bot (optional) — registers guild slash commands and verifies
# incoming Interactions webhook signatures.
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=

# Vercel API (custom domain management, optional)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
