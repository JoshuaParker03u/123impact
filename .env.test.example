# Copy this to .env.test (gitignored) and fill in with the values `supabase
# start` prints to your terminal — API URL, anon key, and service_role key.
# Do NOT point these at staging or production; tests do real deletes.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Any value works here — only org-public-id.test.ts/api-keys.test.ts read it.
ORG_PUBLIC_ID_SECRET=test-only-secret-not-used-outside-local-suite
